# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# NODE_ENV: Définir sur "production" sur le serveur de déploiement.
NODE_ENV="production"

# DATA_DIR: Répertoire persistant pour store.json, photos/ et audit.ndjson.
DATA_DIR="./data"

# SESSION_SECRET: Secret HMAC-SHA256 (>= 32 caractères) pour signer les sessions.
SESSION_SECRET=""

# CODE_HMAC_SECRET: Secret dédié (>= 32 caractères, à ne jamais changer après création des agents).
CODE_HMAC_SECRET=""

# BOOTSTRAP_TOKEN: Jeton secret (>= 12 caractères) requis en production pour créer le premier admin.
BOOTSTRAP_TOKEN=""
